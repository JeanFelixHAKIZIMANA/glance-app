# .env holds the live project. Copy this to .env.local to point at another project; without values the app runs offline with sample stats.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Optional: link appended to shared results
EXPO_PUBLIC_SHARE_URL=https://glance.example.com
